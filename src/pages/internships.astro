---
import MainLayout from "../layouts/mainLayout.astro";
import BgLayout from "../layouts/bgLayout.astro";

import Heading from "../components/pageHeading.astro";
import PageSection from "../components/pageSection.astro";
import Button from "../components/button.astro";
import Link from "../components/link.astro";
import AppImage from "../components/appImage.astro";
import Card from "../components/card.astro";
---

<BgLayout>
  <PageSection class="space-y-12">
    <!-- Main Content -->
    <section
      class="grid
        xl:grid-cols-2
        gap-12
        items-center"
    >
      <!-- Left -->
      <div class="space-y-6">
        <Heading level="h1" variant="title"> Summer Internships </Heading>

        <div class="space-y-4 max-w-xl">
          <p class="text-xl font-semibold">Join Our Research Community</p>

          <p class="text-lg leading-relaxed text-neutral-700">
            Explore opportunities in computational biology, citizen science, and
            collaborative research.
          </p>
        </div>

        <Link href="https://rosettacommons.org/education/reu/" external newTab>
          <Button variant="primary"> Apply Now &rarr; </Button>
        </Link>
      </div>

      <!-- Right -->
      <div class="relative flex justify-center">
        <AppImage
          src="/images/interns.svg"
          alt="internship"
          class="relative z-10
            w-full
            max-w-lg
            drop-shadow-xl"
        />
      </div>
    </section>

    <!-- Impact Panel -->
    <Card variant="accent" class="bg-[var(--color-secondary-tinted)]">
      <div class="flex gap-5 items-start">
        <!-- Icon -->
        <div class="h-14 w-14 rounded-full bg-[var(--color-secondary)]/10
        flex items-center justify-center shrink-0"
        >
          <AppImage
            src="images/icons/star.svg"
            alt="star icon"
            variant="icon"
          />
        </div>

        <!-- Content -->
        <div class="space-y-2">
          <Heading level="h2" variant="md" noMargin> Make an Impact </Heading>

          <p class="text-muted">
            Contribute to meaningful research while gaining valuable experience
            for your future career.
          </p>
        </div>
      </div>
    </Card>
  </PageSection>
</BgLayout>
