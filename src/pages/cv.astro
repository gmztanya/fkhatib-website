---
import MainLayout from "../layouts/mainLayout.astro";
import Card from "../components/card.astro";
import Heading from "../components/pageHeading.astro";
import PageSection from "../components/pageSection.astro";
import AppImage from "../components/appImage.astro";

import cv from "../data/cv.json";
---

<MainLayout>

  <PageSection class="space-y-4">

    <Heading level="h1" variant="title"> CV </Heading>

    <!-- Profile Card -->
    <Card variant="accent" class="overflow-hidden" noPadding>
      <div class="flex flex-col md:flex-row items-center">
        <!-- Image Section -->
        <div class="w-full md:w-auto tinted-bg px-8 py-8 flex justify-center items-center">
          <AppImage
            src={cv.profile.image}
            alt={cv.profile.name}
            class="w-35 h-35 rounded-full object-cover shadow-md"
          />
        </div>

        <!-- Content Section -->
        <div class="flex-1 px-8 py-8 text-center md:text-left">
          <Heading level="h2" variant="lg" class="uppercase tracking-wide">
            {cv.profile.name}
          </Heading>
          <p class="mt-3 font-semibold">
            {cv.profile.title}
          </p>
          <p class="mt-1 text-gray-600">
            {cv.profile.org}
          </p>
          <!-- Divider -->
          <div class="mt-6 border-t border-[var(--color-secondary)]"></div>
        </div>
      </div>
    </Card>

    <!-- Education -->
    <Card variant="accent" noPadding>
      <div class="tinted-bg px-5 py-4">
        <Heading level="h3" variant="md" class="uppercase" noMargin> Education </Heading>
      </div>
      <div class="p-5">
        <ul class="space-y-2">
          {cv.education.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </Card>

    <!-- Experience -->
    <Card variant="accent" noPadding>
      <div class="tinted-bg px-5 py-4">
        <Heading level="h3" variant="md" class="uppercase" noMargin> Research and Professional Experience </Heading>
      </div>
      <div class="p-5">
        <ul class="space-y-2">
          {cv.experience.map((exp) => (
            <li>
              <strong>{exp.period}:</strong> {exp.text}
            </li>
          ))}
        </ul>
      </div>
    </Card>

  </section>
</PageSection>