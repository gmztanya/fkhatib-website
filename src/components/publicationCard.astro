---
import Link from "./link.astro";
import Button from "./button.astro";
import Card from "./card.astro";

const { publication, tinted = false } = Astro.props;

const { title, authors, journal, year, doi, pdf, volume } = publication;
---

<Card variant="accent" class={tinted ? "bg-[var(--color-secondary-tinted)]" : ""}>
  <!-- Top Meta Data -->
  <p class="text-sm text-muted mb-1">
    {year} · {journal} {volume ? `. ${volume}` : ""
      }
  </p>

  <!-- Title -->
  <h3 class="text-lg font-semibold text-strong">
    {title}
  </h3>

  <!-- Authors -->
  <p class="text-sm italic text-strong mb-1 line-clamp-2">
    {authors.join(", ")}
  </p>

  <!-- Doi (Only if exists) -->
  {
    doi && (
      <Link href={doi} external newTab variant="muted" class="mb-1 block">
        {doi.replace("https://", "")}
      </Link>
    )
  }

  <!-- Actions -->
  <div class="flex gap-3 mt-3 flex-wrap">
    <Button
      class="copy-btn"
      data-citation={`${authors.join(", ")}. ${title}. ${journal} (${year})${
        volume ? ` ${volume}` : ""
      }${
        doi ? ` ${doi}` : ""
      }`}
    >
      Copy Citation
    </Button>
    {
      pdf && (
        <Link href={pdf} external newTab>
          <Button variant="secondary"> View PDF </Button>
        </Link>
      )
    }
  </div>
</Card>
